---
import Footer from "../components/footer.astro"
import Navbar from "../components/navbar.astro"
import { Image } from 'astro:assets';
import dvdLogoLarge from '../../public/img/DVD_Logo_2560x1440.png';
import '../../global.css'
//import { ViewTransitions } from "astro:transitions"; zamrdává loading skriptů
---

<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <!-- <ViewTransitions /> -->
        <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
        <script src="https://unpkg.com/aos@2.3.1/dist/aos.js" onload="AOS.init()"></script>
    </head>
    <body class="flex flex-col min-h-screen bg-gradient-to-r from-neutral-800 to-[#333333]">
        <div class="relative pattern-topography-inherit">
            <div class="pointer-events-none absolute inset-0 bg-black/50"></div>

            <div class="relative z-10">
                <div class="grow bg-cover">
                    <div>
                        <Navbar />
                        <slot/>
                    </div>
                </div>
                <Footer />
            </div>
        </div>
    </body>
</html>

