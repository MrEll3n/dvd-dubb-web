---
interface Props {
  href: string;
  label: string;
}

let { href, label} = Astro.props;

let showBorders: boolean = false; 

//link = '#'+link;

---

<div class:list={[ 'flex items-center']}>
      <a href={href} class="font-nexaBold text-white px-4 py-2 border-2 rounded hover:border-red-500 transition">{label}</a>
</div>

