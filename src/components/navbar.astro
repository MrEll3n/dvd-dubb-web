---
import NavJump from "./navJump.astro"
import NavJumpBordered from "./navJumpBordered.astro"
---



<nav class="hidden sm:hidden md:hidden lg:block fixed t-0 w-full z-20"> <!-- bg-white -->
    <!--  Main navigation container -->
    <div id="bg" class="relative h-20 transition"> <!-- border-b  -->
        <div class="flex flex-row space-x-6 h-20 justify-center"> 
            <div class="absolute flex flex-row space-x-6 h-20 left-0 items-center pl-14" >
                <a href="/"><img class="hover:opacity-80 transition" src="img/DVD_Logo_800x800.png" alt="Logo" width="125" height="125"></a>
                
            </div>
            <div class="flex flex-row space-x-6 h-20">
                <NavJump link="news" label="Novinky" selected={false} />
                <NavJump link="about" label="O nás" selected={false} />
                <NavJump link="crew" label="Členové" selected={false} />
                <NavJump link="showcase" label="Ukázka prací" selected={false} />
                <NavJump link="gallery" label="Galerie" selected={false} />
                <NavJump link="https://www.patreon.com/michalstevenkaspar" label="Patreon" selected={false} />
            </div>
            <div class="absolute flex flex-row space-x-6 h-20 right-0 pr-14"> 
                <NavJumpBordered link="contact" label="Kontakt" selected={false} />
            </div>
        </div>
    </div>
</nav>

<script type="module">
    const navbar = document.getElementById("bg");

    window.onscroll = () => {
    if (window.scrollY > 60) {
        //navbar.classList.add('bg-neutral-900');
        navbar.classList.add('shadow-md');
        navbar.classList.add('backdrop-filter')
        navbar.classList.add('backdrop-blur-2xl')
    } else {
        //navbar.classList.remove('bg-neutral-900');
        navbar.classList.remove('shadow-md');
        navbar.classList.remove('backdrop-filter')
        navbar.classList.remove('backdrop-blur-2xl')
    }
};
</script>

