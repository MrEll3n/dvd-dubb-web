---
import ContactInput from "./contactInput.astro"
import ContactSubmit from "./contactSubmit.astro"
import ContactTextArea from "./contactTextArea.astro"
---



<div class="container flex mx-auto my-10">
    <div class="w-full flex flex-row grid-cols-2 justify-center rounded-xl p-4"> <!-- bg-gradient-to-r from-[#363636] to-[#494949] shadow-neutral-800 from-20% to-80% --->
        <div class="flex flex-col justify-center items-center w-2/6 mx-auo font-nexa text-white">
            <p>D.V.D - Dabing Všeho Druhu</p>
        </div>
        <span class="my-5 mx-5 border border-neutral-600"></span>
        <div class="flex flex-col flex-wrap justify-center items-center w-2/6 space-y-6 z-10" >
            <ContactInput label="Jméno" />
            <ContactInput label="Email" />
            <ContactInput label="Předmět" />
            <ContactTextArea label="Vaše zpráva" />
            <ContactSubmit />
        </div>   
    </div>
</div>  