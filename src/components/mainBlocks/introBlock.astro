<!-- AOS -->
<script>
  import AOS from "aos";
  import "aos/dist/aos.css";

  AOS.init();

  // Parallax funkce
  const handleScroll = () => {
    const el = document.querySelector("[data-parallax]");
    if (!el) return;

    const offset = window.scrollY * 0.3;
    el.style.backgroundPosition = `center ${-offset}px`;
  };

  // Hned při načtení
  handleScroll();

  // Při scrollu
  window.addEventListener("scroll", handleScroll);
</script>

<section
  data-parallax
  class="relative h-screen overflow-hidden bg-cover 
         bg-[position:center_0px]
         bg-[url('/img/wallpaper1.jpg')]"
>
  <!-- dark overlay -->
  <div class="absolute inset-0 bg-black/75"></div>

  <!-- content -->
  <div class="relative z-10 flex flex-col justify-center items-center h-full gap-y-12">
    <div class="container relative flex justify-center pt-20">
      <img
        data-aos="fade-left"
        data-aos-duration="1100"
        src="/img/DVD_Logo_2560x1440.png"
        alt="Logo"
        width="1000"
        height="600"
      />
    </div>

    <div class="flex justify-center font-nexaBold text-white w-4/6 h-full">
      <p
        data-aos="fade-right"
        data-aos-duration="1100"
        class="text-4xl bg-clip-text text-transparent bg-gradient-to-r from-red-500 to-yellow-300 from-45% to-95%"
      >
        Když tě štvou titulky, pusť si to s dabingem.
      </p>
    </div>
  </div>

</section>
