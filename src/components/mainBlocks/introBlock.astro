<!-- AOS -->
<script>
  import AOS from "aos";
  import "aos/dist/aos.css";

  AOS.init();
</script>

<section
  data-parallax
  class="relative h-screen overflow-hidden bg-cover bg-center bg-[url('/img/wallpaper1.jpg')]"
>
  <!-- dark overlay -->
  <div class="absolute inset-0 bg-black/75"></div>

  <!-- content -->
  <div class="relative z-10 flex flex-col justify-center items-center h-full gap-y-12">
    <div class="relative flex justify-center pt-20">
      <img
        data-aos="fade-left"
        data-aos-duration="1100"
        src="/img/DVD_Logo_2560x1440.png"
        alt="Logo"
        width="1000"
        height="600"
      />
    </div>

    <div class="flex justify-center font-nexaBold text-4xl text-white w-4/6">
      <p
        data-aos="fade-right"
        data-aos-duration="1100"
        class="h-[3em] bg-clip-text text-transparent bg-gradient-to-r from-red-500 to-yellow-300 from-45% to-95%"
      >
        Když tě štvou titulky, pust si to s dabingem.
      </p>
    </div>
  </div>

  <!-- <!-- WAVE DIVIDER OVER HERO BOTTOM --> -->
