</section>

<script is:global>
  window.addEventListener("scroll", () => {
    const el = document.querySelector("[data-parallax]");
    if (!el) return;

    const offset = window.scrollY * 0.3;
    el.style.backgroundPosition = `center ${-offset}px`;
  });
</script>
