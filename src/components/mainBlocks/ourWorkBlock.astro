---
const projects = [
  {
    title: "Fanouškovský dabing – Helluva Boss - S2E12 - Hříšnoce",
    role: "Kompletní český dabing",
    year: "2025",
    type: "Seriál",
    image: "/img/projects/hb-2025-s2e12.jpg",
    description:
        "Celý dvanáctý díl z druhé série seriálu Helluva Boss, který byl kompletně předabován a přezvučen do češtiny včetně obrazu.",
    url: "https://www.youtube.com/watch?v=7nzDZO7TfIY",
  },
  {
    title: "Na Dosah - Pilot",
    role: "Dialogy + režie dabingu",
    year: "2025",
    type: "Seriál",
    image: "/img/projects/catching-up-pilot.jpg",
    description:
        "Pilot seriálu \"Catching Up\", také známý pod českým názvem \"Na Dosah\", je jeden z projektů, který dostal od skupiny Dabing Všeho Druhu oficiální český dabing, který lze nastavit jakožto zvuková stopa ve videu.",
    url: "https://www.youtube.com/watch?v=EmXj9ZlFZRo",
  },
  {
    title: "Tom Cardy - PÁN PRSTENŮ",
    role: "Vokály + sound design",
    year: "2025",
    type: "Hra",
    image: "/img/projects/tom-cardy-song.jpg",
    description:
        "Český cover na písničku od Hudebníka Toma Cardyho, který převypráví příběh Pána Prstenů.",
    url: "https://youtu.be/your-link-3",
  },
];
---

<section id="ourWork" class="py-24">
  <div class="mx-auto w-full max-w-6xl px-6 text-white">
    <!-- Header -->
    <div class="mb-10 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-3xl md:text-4xl font-nexaBold">Ukázka prací</h2>
        <p class="mt-2 text-base md:text-lg text-white/70">
          Malý výběr projektů, na kterých jsme v Dabingu všeho druhu pracovali.
        </p>
      </div>

      <a
        href="https://www.youtube.com/@msk-dabingvsehodruhu" 
        class="inline-flex items-center justify-center rounded-full border border-white/40 px-5 py-2 text-sm font-semibold text-white/80 hover:bg-white/10 transition"
      >
        🎬 Více ukázek na YouTube
      </a>
    </div>

    <!-- Cards -->
    <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
      {projects.map((p) => (
        <article class="group flex flex-col overflow-hidden rounded-xl border border-white/15 bg-white/5 backdrop-blur-sm shadow-lg">
          <!-- Thumbnail -->
          <div class="relative aspect-video overflow-hidden">
            <img
              src={p.image}
              alt={p.title}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent" />
            <button
              class="absolute bottom-3 left-3 inline-flex items-center gap-2 rounded-full bg-red-600 px-3 py-1 text-xs font-semibold text-white shadow group-hover:bg-red-500 transition"
            >
              ▶ Přehrát ukázku
            </button>
          </div>

          <!-- Content -->
          <div class="flex flex-1 flex-col gap-3 p-5">
            <div class="flex items-center justify-between text-xs text-white/60">
              <span>{p.type} · {p.year}</span>
              <span class="rounded-full bg-white/10 px-2 py-0.5 text-[11px]">
                {p.role}
              </span>
            </div>

            <h3 class="text-lg font-semibold">
              {p.title}
            </h3>

            <p class="flex-1 text-sm text-white/80">
              {p.description}
            </p>

            <a
              href={p.url}
              target="_blank"
              rel="noreferrer"
              class="mt-2 inline-flex items-center gap-2 text-sm font-semibold text-red-400 hover:text-red-300 transition"
            >
              Přehrát na YouTube
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
