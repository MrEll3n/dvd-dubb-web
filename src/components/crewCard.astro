---
interface Props {
    imgSrc: string;
    imgAlt: string;
    name: string;
    role: string;

}

let {imgSrc, imgAlt, name, role} = Astro.props;

---


<div class="shrink w-4/12 md:w-3/12 lg:w-2/12 px-6 py-6 lg:px-4 lg:py-4 xl:px-6 xl:py-6">
    <a href="">
    <div class="flex rounded-md flex-col bg-[#383838] shadow-neutral-800 shadow-sm hover:scale-105 hover:shadow-md border-2 border-neutral-600 transition">
        <img class="rounded-t-md w-full max-h-40 md:max-h-32 lg:max-h-32 xl:max-h-40 object-cover" src={imgSrc != "" ? imgSrc : "img/unknown_member.jpg"} alt={imgAlt}>
        <div class="flex flex-col items-center">
            <h1 class="font-nexa text-white">{name}</h1>
            <p class="font-nexa text-white">{role}</p>
        </div>
    </div>
    </a>
</div>